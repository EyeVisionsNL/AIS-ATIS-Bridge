[Unit]
Description=AIS-ATIS Bridge
After=network-online.target ais-catcher.service
Wants=network-online.target

[Service]
Type=simple
User=aisatis
Group=aisatis
SupplementaryGroups=plugdev
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=AIS_ATIS_CONFIG=/etc/ais-atis-bridge/config.json
Environment=AIS_ATIS_VERSION_FILE=/opt/ais-atis-bridge/VERSION
Environment=AIS_ATIS_CHANNEL_STATE=/etc/ais-atis-bridge/update-channel.json
Environment=AIS_ATIS_UPDATE_STATUS=/var/lib/ais-atis-bridge/update-status.json
ExecStart=/opt/ais-atis-bridge/venv/bin/ais-atis-bridge
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/etc/ais-atis-bridge

[Install]
WantedBy=multi-user.target
